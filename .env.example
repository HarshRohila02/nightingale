# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env

# --- Neo4j ---------------------------------------------------------------- #
# The team uses Neo4j AuraDB Free (decision D-6; setup in docs/11 §5). Copy the
# URI, username and password from the credentials file Aura gives you, e.g.
#   NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
# NEO4J_USERNAME, as Aura's file spells it, works in place of NEO4J_USER. Leave
# NEO4J_DATABASE empty: the store then uses the home database, which on AuraDB is
# named after the instance id, not "neo4j".
# The values below are the local-Docker defaults (docker-compose.yml), kept for
# anyone running Neo4j locally instead.
NEO4J_USER=neo4j
NEO4J_PASSWORD=nightingale
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=

# --- NCBI / PubMed -------------------------------------------------------- #
# An API key raises the E-utilities rate limit from 3 to 10 requests/second.
# Free: https://www.ncbi.nlm.nih.gov/account/  (Settings -> API Key Management)
# NCBI asks that you identify yourself in requests.
NCBI_API_KEY=
NCBI_EMAIL=

# --- Ollama --------------------------------------------------------------- #
OLLAMA_HOST=http://localhost:11434

# --- Hugging Face --------------------------------------------------------- #
# Only needed for gated datasets; the datasets we use are public.
HF_TOKEN=
